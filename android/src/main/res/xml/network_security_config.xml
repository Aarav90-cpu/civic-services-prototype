<network-security-config>
    <!-- Allow cleartext HTTP to any host for debug/dev builds.
         The base-config covers all traffic; the domain-config entries
         below make intent explicit for the private ranges we use. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.31.81</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
